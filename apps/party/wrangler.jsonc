{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barbu",
  "main": "src/server.ts",
  "compatibility_date": "2024-11-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "Main", "class_name": "BarbuServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BarbuServer"] }]
}
